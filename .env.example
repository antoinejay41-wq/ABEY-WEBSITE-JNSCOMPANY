# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Firebase Client Configuration for Production (Vercel & Custom Domain)
# Note: The application includes safe built-in defaults for project abey-accessories-boutique,
# but setting these in Vercel Project Settings > Environment Variables is recommended for production.
VITE_FIREBASE_API_KEY="YOUR_FIREBASE_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="abey-accessories-boutique.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="abey-accessories-boutique"
VITE_FIREBASE_STORAGE_BUCKET="abey-accessories-boutique.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="825599471380"
VITE_FIREBASE_APP_ID="1:825599471380:web:27b07033de6a2df43e5c01"
VITE_FIREBASE_MEASUREMENT_ID=""
