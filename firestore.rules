rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened Global Helpers
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // Owner / Administrator check
    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email == 'antoinejay41@gmail.com' && request.auth.token.email_verified == true) ||
        (request.auth.token.email == 'owner@abeyaccessories.com' && request.auth.token.email_verified == true) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Connection health check
    match /test/{docId} {
      allow read: if true;
    }

    // Products: Publicly readable, writeable by admins
    match /products/{productId} {
      allow read: if true;
      allow create: if isAdmin() && isValidId(productId) &&
        incoming().name is string && incoming().name.size() <= 150 &&
        incoming().category is string && incoming().category.size() <= 60 &&
        incoming().price is number && incoming().price >= 0;
      allow update: if isAdmin() && isValidId(productId) &&
        incoming().name is string && incoming().name.size() <= 150 &&
        incoming().price is number && incoming().price >= 0;
      allow delete: if isAdmin() && isValidId(productId);
    }

    // Categories: Publicly readable, writeable by admins
    match /categories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isAdmin() && isValidId(categoryId);
    }

    // Orders: Anyone can create a valid order, list/manage restricted to admin
    match /orders/{orderId} {
      allow get: if isAdmin();
      allow list: if isAdmin();
      allow create: if isValidId(orderId) &&
        incoming().reference is string && incoming().reference.size() <= 32 &&
        incoming().customerName is string && incoming().customerName.size() <= 120 &&
        incoming().customerWhatsApp is string && incoming().customerWhatsApp.size() <= 40 &&
        incoming().total is number && incoming().total >= 0 &&
        incoming().currency is string && incoming().currency.size() <= 10;
      allow update: if isAdmin() && isValidId(orderId);
      allow delete: if isAdmin() && isValidId(orderId);
    }

    // Admins Collection
    match /admins/{adminId} {
      allow read, write: if isAdmin() && isValidId(adminId);
    }

    // Storefront Configuration & Content
    match /siteContent/{contentId} {
      allow read: if true;
      allow write: if isAdmin() && isValidId(contentId);
    }
  }
}
